{
  "AuroraStorage": {
    "StagingRoot": "D:\\Staging",
    "VaultsRoot": "D:\\Vaults",
    "DefaultChunkSizeMiB": 16,
    "MaxChunkSizeMiB": 32,
    "OrphanSessionHours": 72,
    "ImmediatePostAssemblyCleanup": true
  },
  "Auth": {
    "AccessTokenMinutes": 20,
    "RefreshTokenHours": 24
  },
  "Notifications": {
    "Email": {
      "Enabled": true,
      "Provider": "SMTP",
      "SmtpHost": "smtp.example.com",
      "SmtpPort": 587
    },
    "Telegram": {
      "Enabled": true,
      "BotTokenEnvVar": "AURORA_TELEGRAM_BOT_TOKEN",
      "DefaultChatId": ""
    },
    "NotifyOnSuccess": true,
    "NotifyOnFailure": true
  }
}